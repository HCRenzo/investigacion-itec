# Copia este archivo a .env y completa los valores. .env NO se sube a git.

# API de Supabase (Project Settings > API)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_KEY=<publishable o secret key>

# Conexion a Postgres (Project Settings > Database > Connection string).
# En Vercel usa el POOLER en modo transaccion (puerto 6543):
#   postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

SECRET_KEY=
ADMIN_PASSWORD=
RECEIPT_ENGINE=v2
SEED_DEMO_CUSTOMER=1
